# Copy to `.env` on the EC2 server and fill in real values. Never commit .env.

# ---- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tug202_user
DB_PASSWORD=
DB_NAME=tug202

# ---- Backend --------------------------------------------------------------
# nginx proxies /api/* to this port. Keep it off 3000 so it never collides
# with another app on the same box.
PORT=3202
NODE_ENV=production

# ---- Sessions -------------------------------------------------------------
# Signs the portal session cookie. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
# Base URL used in invite / reset links.
APP_BASE_URL=https://tug202.org

# ---- Admin ----------------------------------------------------------------
# Bearer token for the read-only /api/admin/* endpoints (export submissions).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-me-with-a-long-random-string

# ---- SMTP (optional) ------------------------------------------------------
# Leave SMTP_HOST blank to log outbound mail to the PM2 console instead of
# sending. Submissions are always saved to MySQL regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tug202.org

# Where contact / volunteer notifications are delivered. Comma-separate for
# several recipients. Blank = no notification email (rows still saved).
NOTIFY_EMAIL=
